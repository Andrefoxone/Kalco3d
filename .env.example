# ── Supabase (progetto "Kalco3D", regione Francoforte) ──────────
# Valori pubblici: vanno nel browser, si possono committare
VITE_SUPABASE_URL=https://wnhhldarjwfluhegcpgg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ByA0HQss-9pLheZNDL1qxw_PgDUKbtk
# VITE_AUTH_GOOGLE=1       # mostra "Accedi con Google" (attiva prima Google in Supabase → Authentication → Providers)

# Solo server — SEGRETI, mai nel browser né su git
SUPABASE_URL=https://wnhhldarjwfluhegcpgg.supabase.co
SUPABASE_SECRET_KEY=       # Supabase → Project Settings → API Keys → Secret keys (sb_secret_…)
DATABASE_URL=              # Supabase → Connect → Transaction pooler (porta 6543), con la password del database
# SUPABASE_BUCKET=kalco3d  # bucket privato dei file (già creato)

# ── Motori foto → 3D (basta almeno uno) ──────────────────────
TRIPO_API_KEY=            # https://platform.tripo3d.ai — base, bozze e gioco (P2)
MESHY_API_KEY=            # https://www.meshy.ai/api — Meshy 7.1, texture curate
HYPER3D_API_KEY=          # https://hyper3d.ai — Rodin Gen-2, qualità Pro
FAL_KEY=                  # https://fal.ai — immagini da testo (FLUX.2 pro), TRELLIS.2 (bozze) e Hunyuan3D
# ENABLE_HUNYUAN=1        # Hunyuan è spento: licenza da chiarire per l'UE

# ── Pagamenti (Stripe) ──────────────────────────────────
# Senza queste variabili l'app funziona, ma i pagamenti restano spenti.
STRIPE_SECRET_KEY=        # chiave segreta (sk_live_… o sk_test_…) — solo su Railway
STRIPE_WEBHOOK_SECRET=    # whsec_… dell'endpoint /api/stripe/webhook
STRIPE_PRICE_MAKER=       # price_… abbonamento mensile 19 €
STRIPE_PRICE_PRO=         # price_… abbonamento mensile 49 €
STRIPE_PRICE_STUDIO=      # price_… abbonamento mensile 119 €
STRIPE_PRICE_PACK=        # price_… ricarica una tantum 15 € (100 crediti)
# STRIPE_AUTOMATIC_TAX=1  # IVA calcolata da Stripe Tax (va attivato su Stripe)
# APP_URL=https://kalco3d-production.up.railway.app   # indirizzo di ritorno dopo il pagamento

# ── Amministratori ──────────────────────────────────────
# Email (separate da virgola) che generano senza scalare crediti
# ADMIN_EMAILS=tu@esempio.it

# ── Varie ───────────────────────────────────────────────────
# AI_MAX_CONCURRENT=3     # generazioni AI in parallelo per server
# PORT=3000
